# ==============================================================================
# Antigravity Truth Guard - Environment Configuration Template
# Copy this file to .env and fill in your values.
# ==============================================================================

# 1. Google Gemini API Key (Get free key at https://aistudio.google.com/app/apikey)
# Provides 1500 free requests per day (Free Tier).
GEMINI_API_KEY="your-gemini-api-key-here"

# 2. Google Cloud Project ID (Optional if authenticating via ADC `gcloud auth application-default login`)
# Used for Cloud Firestore vector storage and backup Vertex AI access.
GCP_PROJECT="your-google-cloud-project-id"

# 3. Cloud Firestore Database Name
# Default Firestore database is "(default)".
FIRESTORE_DATABASE="(default)"

# 4. Optional Custom Daily Limits
# FREE_TIER_DAILY_LIMIT=1400
# CIRCUIT_BREAKER_HARD_CAP=5000
